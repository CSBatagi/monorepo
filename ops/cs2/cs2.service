[Unit]
Description=CS Batagi CS2 competitive server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=2

[Service]
Type=simple
User=steam
Group=steam
WorkingDirectory=/home/steam/cs2
Environment=HOME=/home/steam
ExecStartPre=+/usr/local/lib/csbatagi/gate.sh close
ExecStartPre=/usr/bin/python3 /usr/local/lib/csbatagi/update-stack.py prepare
ExecStart=/usr/local/lib/csbatagi/launch.py
ExecStartPost=+/usr/local/lib/csbatagi/verify-start.sh
ExecStop=/usr/local/lib/csbatagi/rcon-local.py quit
ExecStopPost=/usr/bin/python3 /usr/local/lib/csbatagi/update-stack.py rollback
Restart=on-failure
RestartSec=15
TimeoutStartSec=3600
TimeoutStopSec=45
KillSignal=SIGINT
LimitNOFILE=65536
UMask=0027
StandardOutput=append:/home/steam/cs2-console.log
StandardError=append:/home/steam/cs2-console.log

[Install]
WantedBy=multi-user.target
