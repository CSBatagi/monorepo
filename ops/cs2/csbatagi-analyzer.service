[Unit]
Description=CS Batagi demo analysis worker (CS Demo Manager CLI)
After=network-online.target
Wants=network-online.target

[Service]
User=steam
Group=steam
Environment=HOME=/home/steam
ExecStart=/usr/bin/python3 /usr/local/lib/csbatagi/demo-analyzer.py
Restart=always
RestartSec=30
Nice=15
IOSchedulingClass=idle
# The game server must keep its memory; a runaway analysis is killed instead.
MemoryMax=3G
UMask=0027

[Install]
WantedBy=multi-user.target
